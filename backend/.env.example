# OpenAI credentials
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Persistence
DATABASE_URL="sqlite:///./data/sarjy_memory.db"

# Local speech-to-text (faster-whisper)
STT_ENABLED=true
WHISPER_MODEL="base.en"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
WHISPER_LANGUAGE="en"
# Drop segments the model considers silence / low confidence
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_VAD_FILTER=false
PARTIAL_INTERVAL_MS=600

# Voice activity detection / endpointing
VAD_AGGRESSIVENESS=3
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_MS=500
VAD_SPEECH_PAD_MS=150
VAD_BARGE_IN_MIN_SPEECH_MS=400
# Per-frame RMS gate; 0 disables it
VAD_MIN_ENERGY=0.0
# Force an endpoint after this long so noisy rooms still get a response
MAX_UTTERANCE_MS=15000

# Local text-to-speech - provider: "piper" or "kokoro"
TTS_ENABLED=true
TTS_PROVIDER="piper"

# Piper (used when TTS_PROVIDER=piper)
PIPER_VOICE_PATH="data/piper/en_US-lessac-high.onnx"
PIPER_USE_CUDA=false

# Kokoro (used when TTS_PROVIDER=kokoro)
KOKORO_MODEL_PATH="data/kokoro/kokoro-v1.0.onnx"
KOKORO_VOICES_PATH="data/kokoro/voices-v1.0.bin"
KOKORO_VOICE="af_heart"
KOKORO_SPEED=1.0
KOKORO_LANG="en-us"

# Audio contract
SAMPLE_RATE=16000

# Auth
AUTH_ISSUER="sarjy"
AUTH_AUDIENCE="sarjy-api"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Comma-separated list of allowed browser origins (CORS)
FRONTEND_ORIGINS="http://localhost:5173"

# Observability
LOG_LEVEL="INFO"
LOG_FORMAT="text"
