# OpenAI credentials
OPENAI_API_KEY=""

# Persistence
DATABASE_URL="sqlite:///./sarjy_memory.db"

# Local speech-to-text (faster-whisper)
STT_ENABLED=true
WHISPER_MODEL="base.en"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
WHISPER_LANGUAGE="en"
PARTIAL_INTERVAL_MS=600

# Local text-to-speech (Piper) - path to the .onnx voice model
TTS_ENABLED=true
PIPER_VOICE_PATH=""
PIPER_USE_CUDA=false

# Audio contract
SAMPLE_RATE=16000

# Auth
AUTH_ISSUER="sarjy"
AUTH_AUDIENCE="sarjy-api"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Comma-separated list of allowed browser origins (CORS)
FRONTEND_ORIGINS="http://localhost:5173"

# Observability
LOG_LEVEL="INFO"
LOG_FORMAT="text"
