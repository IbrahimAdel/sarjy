# Copy to terraform.tfvars (do NOT commit) or pass values via TF_VAR_* env vars.
#
# Recommended for secrets:
#   export DIGITALOCEAN_TOKEN="dop_v1_..."
#   export TF_VAR_openai_api_key="sk-..."

app_name       = "sarjy"
region         = "nyc"
github_repo    = "IbrahimAdel/sarjy"
branch         = "master"
deploy_on_push = true

project_name        = "sarjy"
project_environment = "Production"

openai_model = "gpt-4.1-mini"

backend_instance_size_slug = "apps-s-1vcpu-2gb"
backend_instance_count     = 1

stt_enabled   = true
tts_enabled   = true
tts_provider  = "piper"
whisper_model = "base.en"

# Voice activity / endpointing (tune for noisy rooms)
vad_aggressiveness          = 3
vad_min_speech_ms           = 250
vad_silence_ms              = 500
vad_barge_in_min_speech_ms  = 400
max_utterance_ms            = 15000
whisper_no_speech_threshold = 0.6
log_level     = "INFO"
log_format    = "json"

# do_token and openai_api_key are intentionally omitted; set them via env vars.
